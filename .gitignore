.project
.settings
.cache
*.iml
.gradle
# Where the Kotlin plugin keeps its per-build session marker; a build leaves one behind.
.kotlin
/local.properties
/.idea
.DS_Store
build
/captures
bin/
# Local Gradle cache used by ad-hoc verification builds.
/.gradle-user-home/
# Local crash/tombstone/logcat captures.
/logs/

# Local one-dragon build logs (build_<code>.log output of gradle.zipRelease).
/build_*.log

# Local gradle build/deploy logs written by ad-hoc runs (buildV.log, deployP.log, install.log…).
/*.log
# One-shot investigation scratch (logcat/tombstone/rf-gate captures, probe dumps, pid files).
/.tmp*
/.build*.pid
# Root-level `_`-prefixed scratch: logcat dumps (_r1.txt, _clean4.txt), probe output
# (_probe_out.txt) and process snapshots. Written by ad-hoc debugging runs and never meant
# to be committed; without this they show up as untracked noise after every session.
/_*

# Local hooking/debug diagnostic artifacts (hunter logcat/dmesg dumps).
/artifacts/

# Gradle wrapper distribution download cache.
/wrapper/

# JNA / native-platform native library caches pulled in by local tooling.
/native/jansi/
/native/native-platform-*/

# Runtime lock files dropped next to the daemon by local runs.
/daemon/9.6.1/
