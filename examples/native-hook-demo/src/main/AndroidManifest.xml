<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:hasCode="true"
        android:label="Vector Native Hook Demo"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">
        
        <!-- Main activity - process list -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Process detail activity -->
        <activity
            android:name=".ProcessDetailActivity"
            android:exported="false"
            android:label="RegisterNatives Data"
            android:parentActivityName=".MainActivity" />
        
        <!-- ContentProvider for cross-process data transfer -->
        <provider
            android:name=".NativeHookContentProvider"
            android:authorities="com.example.nathookdemo.provider"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- BroadcastReceiver for receiving hook records from injected target processes.
             Target processes send an explicit broadcast directed at this component name,
             so no intent-filter is required; exported=true allows cross-UID delivery. -->
        <receiver
            android:name=".HookReportReceiver"
            android:exported="true" />
        
    </application>
</manifest>
